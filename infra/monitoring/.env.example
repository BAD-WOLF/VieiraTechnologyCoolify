# The control plane token (PLATFORM_METRICS_TOKEN) goes in prometheus/platform_metrics_token
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=https://grafana.example.com
PROMETHEUS_RETENTION=30d
# Private IP of this control node (Loki is reachable by the node agents on it)
PRIVATE_BIND_IP=10.0.0.10
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=ops@example.com
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
