# Generated by Terraform, Ansible and infra/prod/hostrema-prod.sh for one installation:
# addresses, state and secrets that never go to the repository.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
**/terraform.tfvars
**/terraform.tfvars.json
**/*_override.tf
ansible/inventory/*.yml
!ansible/inventory/example.yml
ansible/inventory/group_vars/all/vault.yml
