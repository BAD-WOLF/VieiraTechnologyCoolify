# Managed by Ansible (infra/ansible/roles/wireguard).
[Interface]
Address = {{ wireguard_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_private_key }}
PostUp = iptables -I FORWARD 1 -i %i -d {{ vpc_cidr }} -p tcp --dport 22 -j ACCEPT; iptables -I FORWARD 1 -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -A POSTROUTING -s {{ wireguard_network }} -d {{ vpc_cidr }} -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -d {{ vpc_cidr }} -p tcp --dport 22 -j ACCEPT; iptables -D FORWARD -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -D POSTROUTING -s {{ wireguard_network }} -d {{ vpc_cidr }} -j MASQUERADE
{% for peer in wireguard_peers %}

[Peer]
# {{ peer.name }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips }}
{% endfor %}
