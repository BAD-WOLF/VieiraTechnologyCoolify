# Installed on every execution node by infra/ansible/roles/monitoring-agent.
server:
  http_listen_port: 9080

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: http://{{ loki_host }}:3100/loki/api/v1/push
    external_labels:
      region: {{ region }}
      node: {{ inventory_hostname }}

scrape_configs:
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 15s
    relabel_configs:
      # Only containers deployed by the platform carry tenant_id; operator containers are kept with tenant_id="".
      - source_labels: ['__meta_docker_container_label_tenant_id']
        target_label: 'tenant_id'
      - source_labels: ['__meta_docker_container_label_tenant_plan']
        target_label: 'tenant_plan'
      - source_labels: ['__meta_docker_container_label_coolify_resourceName']
        target_label: 'resource'
      - source_labels: ['__meta_docker_container_label_com_docker_compose_service']
        target_label: 'service'
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: 'container'
