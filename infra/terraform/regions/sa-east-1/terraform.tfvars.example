# cp terraform.tfvars.example terraform.tfvars
ssh_public_key      = "ssh-ed25519 AAAA... operator@example.com"
admin_cidrs         = ["203.0.113.10/32"]
control_plane_cidrs = ["198.51.100.20/32"]

node_count         = 2
node_instance_type = "m6i.8xlarge" # 32 vCPU / 128 GB
control_instance_type = "m6i.2xlarge"

# DNS (optional, Route53). With Cloudflare, point the records to the edge_lb_dns_name output.
route53_zone_id = ""
apps_domain     = "apps.example.com"
edge_domain     = "edge.sa-east-1.example.com"

# Public databases (nodes get Elastic IPs and the 20000-29999 range is opened).
public_database_access = false
nodes_domain           = "sa-east-1.nodes.example.com"

backup_retention_days         = 90
backup_replication_bucket_arn = "" # arn:aws:s3:::vtc-us-east-1-backups-replica
