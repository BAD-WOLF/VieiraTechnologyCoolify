# Generated by Terraform (infra/terraform/regions/${platform_region}). Re-run terraform apply instead of editing.
all:
  vars:
    platform_region: ${platform_region}
    aws_region: ${aws_region}
    vpc_cidr: ${vpc_cidr}
    backup_bucket: ${backup_bucket}
    control_private_ip: ${control.private_ip}
    edge_http_port: ${edge_http_port}
    edge_https_port: ${edge_https_port}
    edge_health_port: ${edge_health}
  children:
    control:
      hosts:
        ${control.name}:
          ansible_host: ${control.public_ip}
          private_ip: ${control.private_ip}
          data_volume_id: ${control.data_volume_id}
    coolify_nodes:
      vars:
        ansible_ssh_common_args: "-o ProxyJump=ubuntu@${control.public_ip}"
      hosts:
%{ for node in nodes ~}
        ${node.name}:
          ansible_host: ${node.private_ip}
          private_ip: ${node.private_ip}
          public_ip: "${node.public_ip}"
          data_volume_id: ${node.data_volume_id}
%{ endfor ~}
