variable "region" {
  type    = string
  default = "sa-east-1"
}

variable "vpc_cidr" {
  type    = string
  default = "10.10.0.0/16"
}

variable "availability_zones" {
  description = "The two availability zones of the subnets (they must offer instance_type). Empty = the first two of the region."
  type        = list(string)
  default     = []

  validation {
    condition     = length(var.availability_zones) == 0 || length(var.availability_zones) == 2
    error_message = "Give exactly two availability zones, or none."
  }
}

variable "ssh_public_key" {
  type = string
}

variable "admin_cidrs" {
  type = list(string)
}

variable "instance_type" {
  description = "Coolify master. 4-8 vCPU and 8-16 GB for ~100 tenants per region."
  type        = string
  default     = "m6i.xlarge"
}

variable "disk_gb" {
  type    = number
  default = 100
}

variable "postgres_version" {
  type    = string
  default = "15"
}

variable "db_instance_class" {
  type    = string
  default = "db.m6g.large"
}

variable "db_backup_days" {
  description = "Daily backups plus point-in-time recovery (WAL) kept by RDS (wiki 6: 30-90 days for data)."
  type        = number
  default     = 30
}

variable "dr_region" {
  description = "Second AWS region that receives a copy of the database backups and transaction logs (point-in-time restore there). Empty = disabled."
  type        = string
  default     = ""
}

variable "redis_node_type" {
  type    = string
  default = "cache.m6g.large"
}

variable "route53_zone_id" {
  type    = string
  default = ""
}

variable "domain" {
  description = "Dashboard domain, e.g. painel.hostrema.com.br"
  type        = string
  default     = ""
}

variable "load_balancer" {
  description = "Serve the dashboard through the Application Load Balancer (ACM certificate, Route53) even with a single instance: the instances then configure themselves at boot, like a cluster. infra/prod/hostrema-prod.sh turns it on."
  type        = bool
  default     = false
}

variable "instance_count" {
  description = "1 = single master (recovered by AWS). 2 or more (or any worker_count) = active/active cluster behind an Application Load Balancer, every instance serving the dashboard and the API and, without workers, the queues and the scheduler too (one instance per task)."
  type        = number
  default     = 1

  validation {
    condition     = var.instance_count >= 1
    error_message = "At least one instance."
  }
}

variable "worker_count" {
  description = "Cluster: instances that only run the queues (Horizon) and the scheduler, outside the load balancer. With workers, the instance_count instances only serve the dashboard, the API and the realtime server. 0 = every instance runs everything."
  type        = number
  default     = 0

  validation {
    condition     = var.worker_count >= 0
    error_message = "worker_count can not be negative."
  }
}

variable "worker_instance_type" {
  description = "Instance type of the workers. Empty = instance_type."
  type        = string
  default     = ""
}

variable "image" {
  description = "Hostrema image used by the cluster instances."
  type        = string
  default     = "ghcr.io/bad-wolf/hostrema:latest"
}

variable "certificate_arn" {
  description = "ACM certificate of the dashboard domain (cluster). Empty = requested and validated through route53_zone_id."
  type        = string
  default     = ""
}

variable "registry_username" {
  description = "GitHub user to pull a private image (cluster)."
  type        = string
  default     = ""
}

variable "registry_password" {
  description = "Token with read:packages for a private image (cluster)."
  type        = string
  default     = ""
  sensitive   = true
}

variable "extra_env" {
  description = "Extra lines of the cluster .env (PLATFORM_EDGE_TOKEN, PLATFORM_METRICS_TOKEN, MAIL_*, ...)."
  type        = map(string)
  default     = {}
  sensitive   = true
}

variable "app_key" {
  description = "Cluster: APP_KEY of the dashboard. Empty = generated by Terraform. Set it to rotate the key (docs/platform.md, \"Rotação de credenciais\")."
  type        = string
  default     = ""
  sensitive   = true
}

variable "app_previous_keys" {
  description = "Cluster: older APP_KEYs still accepted to read data during a rotation (APP_PREVIOUS_KEYS)."
  type        = list(string)
  default     = []
  sensitive   = true
}
